# ============================================================
#  VARIABLES DE ENTORNO — Jesús González Oficial
#  Copia este archivo como ".env.local" (local) y configura
#  las mismas variables en EasyPanel (pestaña Environment).
#  NUNCA subas .env.local al repositorio.
# ============================================================

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://jesusgonzalez.com.co

# --- Captura de leads (webhook n8n actual) ---
# Si lo dejas vacío, se usa el webhook por defecto del código.
NEXT_PUBLIC_WEBHOOK_LEADS=https://velostrategix-n8n.lnrubg.easypanel.host/webhook/whatsapp

# --- Supabase (base de datos + auth del panel admin) ---
# Crear proyecto en https://supabase.com  ->  Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# anon/public key: segura para el navegador (solo lectura con RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...ANON...
# service_role: SOLO en servidor (route handlers / admin). NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...SERVICE_ROLE...

# --- Panel admin ---
# Email autorizado para entrar al panel /admin (Supabase Auth).
ADMIN_EMAIL=jesus@correo.com

# --- Agente IA de SEO (panel admin > Blog > Editar) ---
# API key de OpenAI (https://platform.openai.com/api-keys). Solo servidor.
# Si se deja vacía, el editor manual funciona igual; solo se desactiva
# el botón "Mejorar SEO con IA".
OPENAI_API_KEY=
# Opcional: modelo a usar. Por defecto gpt-4o-mini (barato y capaz).
# OPENAI_MODEL=gpt-4o-mini

# --- Tracking (opcional: hoy están fijos en el código, se pueden mover aquí) ---
# NEXT_PUBLIC_GA_ID=G-HX4CNELDGR
# NEXT_PUBLIC_ADS_ID=AW-17235584981
# NEXT_PUBLIC_CLARITY_ID=upoa7lbpdr
